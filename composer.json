{
    "name": "mj-zana/docs",
    "description": "Zana 2 documentation, with runnable, tested examples",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "mj-zana/audit": "^2.2",
        "mj-zana/cache": "^2.2",
        "mj-zana/communication": "^2.2",
        "mj-zana/configuration": "^2.2",
        "mj-zana/console": "^2.2",
        "mj-zana/container": "^2.2",
        "mj-zana/core": "^2.2",
        "mj-zana/database": "^2.2",
        "mj-zana/ddd": "^2.2",
        "mj-zana/events": "^2.2",
        "mj-zana/filesystem": "^2.2",
        "mj-zana/http": "^2.2",
        "mj-zana/logging": "^2.2",
        "mj-zana/maker": "^2.2",
        "mj-zana/media": "^2.2",
        "mj-zana/mediator": "^2.2",
        "mj-zana/queue": "^2.2",
        "mj-zana/routing": "^2.2",
        "mj-zana/scheduler": "^2.2",
        "mj-zana/security": "^2.2",
        "mj-zana/serialization": "^2.2",
        "mj-zana/session": "^2.2",
        "mj-zana/testing": "^2.2",
        "mj-zana/translation": "^2.2",
        "mj-zana/validation": "^2.2",
        "mj-zana/view": "^2.2",
        "mj-zana/view-markdown": "^2.2",
        "mj-zana/view-twig": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Hello\\": "examples/getting-started/hello/src/",
            "Modules\\": [
                "examples/getting-started/hello/modules/",
                "examples/cookbook/clinic/modules/",
                "examples/cookbook/website/modules/"
            ],
            "Clinic\\": "examples/cookbook/clinic/src/",
            "Website\\": "examples/cookbook/website/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Docs\\Tests\\": "tests/",
            "Hello\\Tests\\": "examples/getting-started/hello/tests/",
            "Clinic\\Tests\\": "examples/cookbook/clinic/tests/",
            "Website\\Tests\\": "examples/cookbook/website/tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
