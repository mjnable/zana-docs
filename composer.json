{
    "name": "mj-zana/docs",
    "description": "Zana 2 documentation, with runnable, tested examples",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "mj-zana/audit": "^2.11",
        "mj-zana/cache": "^2.11",
        "mj-zana/communication": "^2.11",
        "mj-zana/configuration": "^2.11",
        "mj-zana/console": "^2.11",
        "mj-zana/container": "^2.11",
        "mj-zana/core": "^2.11",
        "mj-zana/database": "^2.11",
        "mj-zana/ddd": "^2.11",
        "mj-zana/events": "^2.11",
        "mj-zana/filesystem": "^2.11",
        "mj-zana/http": "^2.11",
        "mj-zana/logging": "^2.11",
        "mj-zana/maker": "^2.11",
        "mj-zana/media": "^2.11",
        "mj-zana/mediator": "^2.11",
        "mj-zana/queue": "^2.11",
        "mj-zana/routing": "^2.11",
        "mj-zana/scheduler": "^2.11",
        "mj-zana/security": "^2.11",
        "mj-zana/serialization": "^2.11",
        "mj-zana/session": "^2.11",
        "mj-zana/testing": "^2.11",
        "mj-zana/translation": "^2.11",
        "mj-zana/validation": "^2.11",
        "mj-zana/view": "^2.11",
        "mj-zana/view-markdown": "^2.11",
        "mj-zana/view-twig": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Hello\\": "examples/getting-started/hello/src/",
            "Modules\\": [
                "examples/getting-started/hello/modules/",
                "examples/cookbook/clinic/modules/",
                "examples/cookbook/website/modules/",
                "examples/agents/library/modules/"
            ],
            "Clinic\\": "examples/cookbook/clinic/src/",
            "Website\\": "examples/cookbook/website/src/",
            "App\\": "examples/agents/library/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Docs\\Tests\\": "tests/",
            "Hello\\Tests\\": "examples/getting-started/hello/tests/",
            "Clinic\\Tests\\": "examples/cookbook/clinic/tests/",
            "Website\\Tests\\": "examples/cookbook/website/tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
